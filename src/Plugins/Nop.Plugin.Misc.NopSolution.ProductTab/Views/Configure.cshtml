@model ProductTabModel
@using Nop.Plugin.Misc.NopSolution.ProductTab.Models;

@{
    Layout = "_ConfigurePlugin";
    ViewBag.PageTitle = T("Admin.Vendors").Text;
    //active menu item (system name)
    //NopHtml.SetActiveMenuItemSystemName("Vendors");
    NopHtml.AddCssFileParts("~/Plugins/Misc.NopSolution.ProductTab/Content/Css/toastr.min.css", excludeFromBundle: false);
    NopHtml.AddScriptParts(ResourceLocation.Footer, "~/Plugins/Misc.NopSolution.ProductTab/Content/Scripts/toastr.min.js", excludeFromBundle: true);   
}
@* #toast-container>div *@
@{
    const string hideSearchBlockAttributeName = "VendorsPage.HideSearchBlock";
    var hideSearchBlock = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideSearchBlockAttributeName);
}

<div class="content-header clearfix">
    <h1 class="float-left">
        @T("Admin.Vendors")
    </h1> 
</div>

<script>
    $(function() {
        $('#activate-selected').on('click',function (e) {
            e.preventDefault();
            var ids = selectedIds.join(",");
            if (!ids) {
                $('#activatedSelected-info').text("@T("Plugins.Misc.NopSolution.ProductTab.Admin.Vendors.NoVendorSelected")");
                $("#activatedSelected").trigger("click");
            }
            else {
                $('#activate-selected-vendor-form #selectedIds').val(ids);
                $('#activate-selected-vendor-form #isSendEmail').val('false')
                //activateVendor(ids, true);
                $('#activate-selected-vendor-form').submit();
            }
            return false;
        });

        $('#activate-selected-send-email').on('click',function (e) {
            e.preventDefault();
            var ids = selectedIds.join(",");

            if (!ids) {
                $('#activatedSelected-info').text("@T("Plugins.Misc.NopSolution.ProductTab.Admin.Vendors.NoVendorSelected")");
                $("#activatedSelected").trigger("click");
            }
            else {
                $('#activate-selected-vendor-form #selectedIds').val(ids);
                $('#activate-selected-vendor-form #isSendEmail').val('true')
                //activateVendor(ids, true);
                $('#activate-selected-vendor-form').submit();
            }
            return false;
        });
    });

    $('#activate-selected-vendor-form').on('submit', function (e) {
        e.preventDefault();

        var postData = $(this).serialize();
        addAntiForgeryToken(postData);
        $.ajax({
            cache: false,
            url: "@(Url.Action("ActivateVendor", "VendorRegistrationAdmin"))",
            type: 'POST',
            data: postData,
            success: function (data, textStatus, jqXHR) {
                toastr.success('@T("Plugins.Misc.NopSolution.ProductTab.Common.UpdateSuccess")', '@T("Plugins.Misc.NopSolution.ProductTab.Common.Success")');
                updateTable('#vendors-grid');
            },
            error: function (xhr, status, error) {
                toastr.error('@T("Plugins.Misc.NopSolution.ProductTab.Common.ErrorMessage")', '@T("Plugins.Misc.NopSolution.ProductTab.Common.Error")');
            }
        });
    });
    function activateVendor(ids, isSendEmail)
    {
        var postData = {
            SelectedIds: ids,
            IsSendEmail: isSendEmail
        };
        addAntiForgeryToken(postData);
        $.ajax({
            cache: false,
            url: "@(Url.Action("ActivateVendor", "VendorRegistrationAdmin"))",
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(postData),
            success: function (response) {
                alert("Success")
                updateTable('#vendors-grid');
            },
            error: function (xhr, status, error) {
                alert("Error: " + error);
            }
        });
    }
</script>
<nop-alert asp-alert-id="activatedSelected" />